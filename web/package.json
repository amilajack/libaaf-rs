{
  "name": "libaaf-import-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/libaaf-wasm --target web --out-dir pkg --release",
    "fixtures": "node scripts/copy-fixtures.mjs",
